{
  "name": "ez-label-printing",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ez-labels",
      "database_id": "b6955b7e-95e6-4167-a915-c458d44cf508"
    }
  ]
}
